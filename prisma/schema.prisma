generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Lomba yang tersedia
model Competition {
  id                    String    @id @default(cuid())
  title                 String
  theme                 String?
  description           String?   @db.Text
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  registrationLink      String    @default("")
  contacts              Json?     // Array of objects: [{ name, phone }]
  tags                  String?   // Hashtags
  imageUrl              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("competitions")
}

// Admin yang bisa login ke dashboard
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Disimpan sebagai bcrypt hash, JANGAN plain text
  name      String
  createdAt DateTime @default(now())

  @@map("admin_users")
}

// Divisi Kepanitiaan
model Division {
  id         String   @id @default(cuid())
  name       String
  imageUrl   String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff      Staff[]

  @@map("divisions")
}

// Anggota Staff dalam suatu divisi
model Staff {
  id          String   @id @default(cuid())
  name        String
  role        String   // Ketua, Wakil Ketua, Anggota
  description String?  @db.Text
  imageUrl    String?
  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([divisionId], map: "staff_divisionId_fkey")
  @@map("staff")
}

// Konfigurasi Situs (Hero, About, dll)
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Sponsor acara
model Sponsor {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?
  link      String?
  tier      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sponsors")
}
