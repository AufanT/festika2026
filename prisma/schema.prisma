generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Lomba yang tersedia
model Competition {
  id                    String    @id @default(cuid())
  title                 String
  theme                 String?
  description           String?   @db.Text
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  registrationLink      String    @default("")
  contacts              Json?     // Array of objects: [{ name, phone }]
  tags                  String?   // Hashtags
  imageUrl              String?
  guidebook             String?   // URL ke file PDF guidebook
  timeline              Json?     // Array of timeline items: [{ label, date, description }]
  prizeList              Json?     // Array of prize items: [{ position, prize, description }]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("competitions")
}

// Past Events - History acara tahun lalu (standalone, tidak bergantung ke competitions)
model PastEvent {
  id              String    @id @default(cuid())
  title           String
  theme           String?
  description     String?   @db.Text
  year            Int       @default(2025)
  eventDate       DateTime? // Tanggal pelaksanaan acara
  imageUrl        String?
  galleryUrls     Json?     // Array of image URLs
  participants    Int?      // Jumlah peserta
  winner          String?   // Juara 1
  runnerUp        String?   // Juara 2
  thirdPlace      String?   // Juara 3
  orderIndex      Int       @default(0) // Untuk sorting
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([year], map: "pastEvent_year_idx")
  @@index([orderIndex], map: "pastEvent_orderIndex_idx")
  @@map("past_events")
}

// Admin yang bisa login ke dashboard
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Disimpan sebagai bcrypt hash, JANGAN plain text
  name      String
  createdAt DateTime @default(now())

  @@map("admin_users")
}

// Divisi Kepanitiaan
model Division {
  id         String   @id @default(cuid())
  name       String
  imageUrl   String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff      Staff[]

  @@map("divisions")
}

// Anggota Staff dalam suatu divisi
model Staff {
  id          String   @id @default(cuid())
  name        String
  role        String   // Ketua, Wakil Ketua, Anggota
  description String?  @db.Text
  imageUrl    String?
  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([divisionId], map: "staff_divisionId_fkey")
  @@map("staff")
}

// Konfigurasi Situs (Hero, About, dll)
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// FAQ items
model Faq {
  id          String   @id @default(cuid())
  question    String   @db.Text
  answer      String   @db.Text
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

// Sponsor acara
model Sponsor {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?
  link      String?
  tier      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sponsors")
}
